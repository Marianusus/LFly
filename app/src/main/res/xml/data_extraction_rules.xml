<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: as backup_rules.xml, for cloud backups and device transfers alike. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lfly_credentials.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lfly_credentials.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
