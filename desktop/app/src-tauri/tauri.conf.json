{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LFly",
  "version": "0.1.0",
  "identifier": "org.sonora.lfly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LFly",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data: cover: http://cover.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "LFly music player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
